# Copia este archivo como .env (junto a compose.yaml). No subas .env a Git.

# Credenciales de la base local que crea Docker (solo para desarrollo).
POSTGRES_USER=gridmind
POSTGRES_PASSWORD=cambia-esta-contrasena

# Obligatorio: secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=

# Opcionales: sin ellas no funcionan el análisis de facturas ni el correo.
GEMINI_API_KEY=
RESEND_API_KEY=

# Rutas a los otros repos (por defecto, carpetas hermanas de este repo).
# FRONTEND_PATH=../GridMind-frontend
# IA_PATH=../GridMind-ia

# Puertos en el host. FRONTEND_PORT debe estar permitido por CORS
# en el backend (5173, 5174, 5175 o 3000).
# FRONTEND_PORT=5173
# BACKEND_PORT=8080
# IA_PORT=5000
# DB_PORT=5432

# Origen que abre el navegador, sin barra final; reconstruir frontend al cambiarlo.
BROWSER_ORIGIN=http://localhost:5173
